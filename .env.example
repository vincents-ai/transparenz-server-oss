# Transparenz Server OSS — Environment Configuration
# Copy to .env and fill in values: cp .env.example .env

# ═══════════════════════════════════════════════════════════
# ── Core (Required) ──────────────────────────────────────
# ═══════════════════════════════════════════════════════════

# PostgreSQL connection string targeting the compliance schema.
# For production: add ?sslmode=require
DATABASE_URL=postgres://user:pass@localhost:5432/transparenz?search_path=compliance&sslmode=disable

# JWT signing secret for authentication.
# Must be >= 32 characters. Generate with: openssl rand -hex 32
# IMPORTANT: Change this in production!
JWT_SECRET=

# AES-256 encryption key for data at rest.
# Must be exactly 32 characters. Generate with: openssl rand -hex 16
ENCRYPTION_KEY=

# ═══════════════════════════════════════════════════════════
# ── Server ───────────────────────────────────────────────
# ═══════════════════════════════════════════════════════════

PORT=8080
LOG_LEVEL=info
MAX_SBOM_SIZE=10485760

# Public base URL (used for CSAF provider metadata canonical URLs)
BASE_URL=http://localhost:8080

# Multi-tenant isolation: shared | schema_per_org | instance_per_org
MULTI_TENANT_MODE=shared

# ═══════════════════════════════════════════════════════════
# ── Instance-per-Org (only if MULTI_TENANT_MODE=instance_per_org) ──
# ═══════════════════════════════════════════════════════════

# JSON file mapping org IDs to DSNs (preferred over INSTANCE_DSNS)
# File should have 0600 permissions. Use with secrets managers.
INSTANCE_DSN_FILE=

# Inline JSON mapping (alternative to file)
INSTANCE_DSNS=

# ═══════════════════════════════════════════════════════════
# ── CORS ─────────────────────────────────────────────────
# ═══════════════════════════════════════════════════════════

# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:8080

# ═══════════════════════════════════════════════════════════
# ── Vulnerability Feeds ──────────────────────────────────
# ═══════════════════════════════════════════════════════════

VULNZ_WORKSPACE_PATH=/var/lib/vulnz/workspace
VULNZ_SYNC_INTERVAL=6h

# ═══════════════════════════════════════════════════════════
# ── SLA & Compliance ─────────────────────────────────────
# ═══════════════════════════════════════════════════════════

ALERT_TICK_INTERVAL=30s
SLA_TICK_INTERVAL=1m
APPROACHING_SLA_THRESHOLD=6h
JOB_QUEUE_POLL_INTERVAL=5s

# ═══════════════════════════════════════════════════════════
# ── Metrics ──────────────────────────────────────────────
# ═══════════════════════════════════════════════════════════

# Basic auth for /metrics endpoint
METRICS_USER=
METRICS_PASSWORD=

# ═══════════════════════════════════════════════════════════
# ── Feature Flags ────────────────────────────────────────
# ═══════════════════════════════════════════════════════════

TELEMETRY_ENABLED=true
VULNZ_DISABLED=false
RATE_LIMIT_DISABLED=false

# ═══════════════════════════════════════════════════════════
# ── Organization Defaults (can be overridden per-org in DB) ──
# ═══════════════════════════════════════════════════════════

# ENISA submission mode: api | csirt | export
# ENISA_SUBMISSION_MODE=export

# CSAF scope: per_cve | per_sbom | batch
# CSAF_SCOPE=per_sbom

# SLA tracking mode: per_cve | per_sbom
# SLA_TRACKING_MODE=per_cve

# ═══════════════════════════════════════════════════════════
# ── Signing Keys ─────────────────────────────────────────
# ═══════════════════════════════════════════════════════════

# Path to Ed25519 signing key for compliance events
# SIGNING_KEY_PATH=/etc/transparenz-server/signing.key

# ═══════════════════════════════════════════════════════════
# ── Development ──────────────────────────────────────────
# ═══════════════════════════════════════════════════════════

# Enable hot reload in development
# DEV_MODE=true
